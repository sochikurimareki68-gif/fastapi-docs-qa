{
  "meta": {
    "name": "FastAPI 文档智能问答助手 · 效果评测用例集",
    "version": "v1.0",
    "scope": "知识库 48 篇 FastAPI 官方中文文档对应模块 + 越界拒答",
    "modes": {
      "answer": "库内问题：回复须命中 expect_any 中至少一个关键词（答案准确率的代理指标）；引用命中率按「返回引用且命中 expect_docs 中任一文档」计算（Hit Rate@K），引用相关度（top-1 得分）单独统计",
      "refuse": "库外问题：回复须包含明确拒答表述（refusal_any 之一），或 top-1 引用得分 < 0.1（检索未命中即应拒答而非编造）"
    },
    "metrics": "①答案准确率（关键词命中代理）②引用命中率（文档级召回）③引用相关度（top-1 得分）④越界拒答率 ⑤平均延迟"
  },
  "cases": [
    {
      "id": "c01",
      "module": "路由基础",
      "mode": "answer",
      "input": "如何定义一个最简单的 FastAPI 接口并运行起来？",
      "expect_any": ["@app.get", "FastAPI()", "uvicorn", "main:app"],
      "expect_docs": ["first-steps.md"]
    },
    {
      "id": "c02",
      "module": "路径参数",
      "mode": "answer",
      "input": "路径参数是什么，怎么声明一个带路径参数的接口？",
      "expect_any": ["路径参数", "item_id", "声明", "{item_id}"],
      "expect_docs": ["path-params.md"]
    },
    {
      "id": "c03",
      "module": "路径参数校验",
      "mode": "answer",
      "input": "如何校验路径参数的数值范围，比如必须大于 0？",
      "expect_any": ["Path", "ge=", "gt=", "le=", "422"],
      "expect_docs": ["path-params-numeric-validations.md"]
    },
    {
      "id": "c04",
      "module": "查询参数校验",
      "mode": "answer",
      "input": "查询参数怎么限制长度和做正则校验？",
      "expect_any": ["min_length", "max_length", "Query", "regex", "pattern"],
      "expect_docs": ["query-params-str-validations.md"]
    },
    {
      "id": "c05",
      "module": "请求体",
      "mode": "answer",
      "input": "怎么声明一个请求体模型来接收 JSON 数据？",
      "expect_any": ["BaseModel", "Pydantic", "Body", "请求体"],
