# FastAPI 文档智能问答助手 后端代理 · 环境变量示例
# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会提交到 GitHub）
# 所有变量都有默认值，下面只列出需要覆盖的场景。

# ---------- 必须配置 ----------

# Dify 应用 API 密钥（Dify → 应用 → 访问 API → API 密钥，app- 开头）
# server.py 使用：/api/chat 的上游凭证，只在服务端持有，绝不发给前端
DIFY_API_KEY=app-xxxxxxxxxxxxxxxx

# Dify API 地址：云平台默认值即可；自部署时改成自己的地址（如 http://your-host/v1）
DIFY_BASE=https://api.dify.ai/v1

# ---------- 知识库导入（upload_docs.py 使用，server.py 用不到）----------

# Dify Dataset API 密钥（Dify → 知识库 → 左侧「API」→ 创建，dataset- 开头）
DIFY_DATASET_API_KEY=dataset-xxxxxxxx

# ---------- 可选配置（有默认值）----------

# 本地监听端口与地址
PORT=3000
HOST=0.0.0.0

# 单次请求体上限（字节）。防止有人 POST 超大 body 消耗内存。
MAX_BODY_BYTES=4096

# 单条消息最大字符数。超过会被拒绝，防止刷长文本消耗 Dify 额度。
MAX_MESSAGE_CHARS=500

# 单 IP 限流：每分钟最多 N 次提问
IP_PER_MINUTE=6

# 单 IP 限流：每天最多 N 次提问
IP_PER_DAY=60

# 全站每日总量上限：所有 IP 加起来每天最多 N 次，兜底止损
GLOBAL_PER_DAY=500

# 并发闸门：同时在处理的提问数上限，超出的请求立刻返回 503（不排队）
# 每个请求要占一个线程、向上游开一条最长 120 秒的连接，不设上限容易被并发刷满
MAX_CONCURRENT=6

# 允许的额外来源（逗号分隔，不带尾斜杠）。
# /api/chat 要求请求带同源 Origin（或 Referer）；前端若部署在别的域名，把域名加进来。
# 例：ALLOWED_ORIGINS=https://your-frontend.com,https://another.com
ALLOWED_ORIGINS=

# 指定 CA 根证书包路径。一般不用填；只有当 Python 报
# "certificate verify failed" 时才需要手动指定。
# DIFY_CA_BUNDLE=/etc/ssl/cert.pem
